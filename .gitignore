# bin/ se sube (repo privado): programa compilado, acciones con fecha y PDF. Los logs del programa no.
bin/Release/Logs/
bin/Release/Pendientes/
obj/
.vs/
*.user

# Caché de Python, bloqueos de Excel abiertos y pruebas sueltas
__pycache__/
*.pyc
~$*
odoo/modulos/_prueba_*

# Eines de compilacio locals (SDK Android, .NET): no es pugen
.android-sdk/
.android-sdk-commandline.zip
.dotnet-cli/

# Ficheros temporales de depuracion (assets descargados de Odoo, etc.)
.tmp_*

# Fase 6 auditoria 13/11 (14/11/2026): binarios fuera de git. Los ficheros siguen en el disco.
# - ZIP de modulos: se generan desde la etiqueta con bin/empaquetar.py (no se versionan).
# - APK de la PDA: a una release de GitHub con su etiqueta.
# - Fotos de producto: fuera del repositorio (pendiente decidir donde).
bin/*.zip
bin/versiones/*.zip
bin/builds/
*.apk
*.idsig
bin/versiones/*imagenes*/

# Programa de redistribución (23/11/2026): configuración local (dirección, bd, usuario) y copias SQLite de Odoo
redistribucion/programa/config.local.toml
redistribucion/programa/copias/
redistribucion/**/*.sqlite
redistribucion/**/*.sqlite-journal
# Mapa v3 (24/11/2026): datos generados desde la copia de Odoo («python programa.py generar-mapa»), ~10 MB
redistribucion/prototipo-mapa_2026-11-24_v3/*.json
