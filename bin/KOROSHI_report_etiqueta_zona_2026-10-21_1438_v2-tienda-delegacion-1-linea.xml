<t t-name="koroshi.report_etiqueta_zona">
    <!--
    KOROSHI - Etiqueta de caja para el picking por zonas (OUT + matricula + delegacion + pedido).
    Vista QWeb (tipo QWeb) para el informe "KOROSHI Etiqueta zona" del modelo stock.picking.
    Una etiqueta 4x6" (101,6 x 152,4 mm) por cada matricula CJ reservada para la OUT
    (zebra.label con nota "ETQ ZONA <OUT>", las reserva la accion KOROSHI_etiquetas_zona).
    Si la OUT aun no tiene matriculas, sale una sola etiqueta con la casilla de matricula vacia.
    Delegacion: de momento la provincia de la tienda (no hay campo de delegacion en Odoo).
    wkhtmltopdf: sin flex, todo con tablas y medidas fijas.
    -->
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="o">
            <t t-set="cjs" t-value="o.env['zebra.label'].search([('note', '=', 'ETQ ZONA ' + o.name)], order='sequence_number')"/>
            <t t-set="zona" t-value="o.batch_id and o.batch_id.name.split('-')[-1] or ''"/>
            <t t-set="nota" t-value="o.note or ''"/>
            <t t-set="caja" t-value="('CAJA ' in nota) and nota.split('CAJA ')[1][:2] or ''"/>
            <t t-set="tienda" t-value="(o.partner_id.name or '').split(', ')[-1]"/>
            <t t-set="prov" t-value="o.partner_id.state_id and o.partner_id.state_id.name.split(' (')[0].strip(' -') or ''"/>
            <!-- Codigos de delegacion PROVISIONALES (por provincia) hasta tener la lista real de XPO -->
            <t t-set="codigos" t-value="{'barcelona': 'BCN', 'madrid': 'MAD', 'bizkaia': 'BIO', 'gipuzkoa': 'EAS', 'zaragoza': 'ZAZ', 'valència': 'VLC', 'girona': 'GRO', 'asturias': 'OVD', 'tarragona': 'TGN', 'valladolid': 'VLL', 'araba/álava': 'VIT', 'lleida': 'LLE', 'navarra': 'PNA', 'león': 'LEN', 'burgos': 'BUR', 'castellon': 'CDT', 'alacant': 'ALC', 'illes balears': 'PMI', 'murcia': 'MUR', 'salamanca': 'SLM', 'palencia': 'PAL', 'cantabria': 'SDR', 'la rioja': 'LOG', 'málaga': 'AGP', 'granada': 'GRX', 'sevilla': 'SVQ', 'a coruña': 'LCG'}"/>
            <t t-set="cod" t-value="codigos.get(prov.lower(), '')"/>
            <t t-set="deleg" t-value="(cod and (cod + ' · ') or '') + prov.upper()"/>
            <t t-set="deleg_pt" t-value="len(deleg) &lt;= 16 and 22 or (len(deleg) &lt;= 20 and 18 or 15)"/>
            <t t-set="tienda_pt" t-value="len(tienda) &lt;= 18 and 21 or (len(tienda) &lt;= 24 and 17 or 13)"/>
            <t t-set="uds" t-value="int(sum(o.move_line_ids.mapped('product_uom_qty')) or sum(o.move_line_ids.mapped('qty_done')))"/>
            <t t-set="total" t-value="len(cjs) or 1"/>
            <t t-foreach="cjs or [False]" t-as="cj">
                <div class="page" style="page-break-after: always; font-family: Arial, Helvetica, sans-serif; color: #000;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="vertical-align: bottom;">
                                <div style="font-size: 8pt; letter-spacing: 1px;">KOROSHI · PICKING POR ZONAS</div>
                                <div style="font-size: 28pt; font-weight: 900; border: 2.5px solid #000; padding: 0 3mm; display: inline-block; line-height: 1.15;" t-esc="zona"/>
                            </td>
                            <td style="text-align: right; vertical-align: bottom;">
                                <div style="font-size: 8pt;">CAJA TIENDA</div>
                                <div style="font-size: 44pt; font-weight: 900; line-height: 0.95;" t-esc="caja"/>
                            </td>
                        </tr>
                    </table>
                    <div style="background: #000; color: #fff; text-align: center; padding: 1.5mm 2mm 2mm; margin-top: 1.5mm;">
                        <div style="font-size: 7.5pt; letter-spacing: 2px;">DELEGACIÓN</div>
                        <div t-attf-style="font-size: {{deleg_pt}}pt; font-weight: 900; line-height: 1.1; white-space: nowrap;" t-esc="deleg"/>
                    </div>
                    <div t-attf-style="font-size: {{tienda_pt}}pt; font-weight: 900; margin-top: 1.5mm; white-space: nowrap; line-height: 1.1;" t-esc="tienda"/>
                    <div style="font-size: 9.5pt;"><t t-esc="o.partner_id.city or ''"/> · <t t-esc="uds"/> uds</div>
                    <table style="width: 100%; border: 3px solid #000; margin-top: 1.5mm;">
                        <tr>
                            <td style="width: 9mm; font-size: 8pt; font-weight: 800; text-align: center;">PE<br/>DI<br/>DO</td>
                            <td style="font-size: 25pt; font-weight: 900; text-align: center;" t-esc="o.origin or ''"/>
                        </tr>
                    </table>
                    <div style="border: 2px solid #000; text-align: center; font-size: 13pt; font-weight: 800; margin-top: 1.5mm;">
                        CAJA <t t-esc="cj_index + 1"/> DE <t t-esc="total"/>
                    </div>
                    <div style="border-top: 1.5px solid #000; margin-top: 1.5mm; padding-top: 1mm;">
                        <table style="width: 100%; font-size: 8.5pt; font-weight: 700;"><tr><td>1 · ESCANEAR PARA ABRIR EN LA PDA</td><td style="text-align: right;">OUT</td></tr></table>
                        <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=0' % ('Code128', o.name, 800, 140)" style="width: 100%; height: 15mm;"/>
                        <div style="font-family: 'Courier New', monospace; font-size: 12pt; font-weight: 700; text-align: center;" t-esc="o.name"/>
                    </div>
                    <div style="border-top: 1.5px solid #000; margin-top: 1mm; padding-top: 1mm;">
                        <table style="width: 100%; font-size: 8.5pt; font-weight: 700;"><tr><td>2 · ESCANEAR AL CERRAR LA CAJA</td><td style="text-align: right;">MATRÍCULA</td></tr></table>
                        <t t-if="cj">
                            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=0' % ('Code128', cj.name, 800, 160)" style="width: 100%; height: 18mm;"/>
                            <div style="font-family: 'Courier New', monospace; font-size: 15pt; font-weight: 700; text-align: center;" t-esc="cj.name"/>
                        </t>
                        <t t-if="not cj">
                            <div style="height: 18mm; border: 1.5px dashed #000; text-align: center; font-size: 10pt; padding-top: 6mm;">SIN MATRÍCULA: usar una CJ preimpresa</div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </t>
</t>
