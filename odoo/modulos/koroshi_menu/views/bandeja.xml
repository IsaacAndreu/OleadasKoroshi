<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v2.4 (auditoría 13/11, fase 7, ideas 2 y 3): Bandeja del encargado. Se calcula al abrir (models/bandeja.py). -->
    <!-- v2.6: la pestaña IT de la bandeja (antes que la vista, que lo usa). Al instalar o actualizar entra «Departament IT» (departamentit@nath.es). -->
    <record id="grupo_it" model="res.groups">
        <field name="name">KOROSHI: IT</field>
        <field name="comment">Ve la pestaña IT de la bandeja del encargado (crons, colas, jobs, sync S4T, lecturas de la PDA).</field>
    </record>

    <record id="view_koroshi_bandeja_linea_tree" model="ir.ui.view">
        <field name="name">koroshi.bandeja.linea.tree</field>
        <field name="model">koroshi.bandeja.linea</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false"
                  decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                  decoration-success="semaforo == 'verde'" decoration-muted="semaforo == 'gris'">
                <field name="semaforo" invisible="1"/>
                <field name="accion" invisible="1"/>
                <field name="marca"/>
                <field name="que"/>
                <field name="cuantos"/>
                <field name="detalle"/>
                <button name="action_abrir" type="object" string="Abrir" icon="fa-arrow-right"
                        attrs="{'invisible': [('accion', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <record id="view_koroshi_bandeja_form" model="ir.ui.view">
        <field name="name">koroshi.bandeja.form</field>
        <field name="model">koroshi.bandeja</field>
        <field name="arch" type="xml">
            <form string="Bandeja del encargado" create="false" edit="false" delete="false">
                <header>
                    <button name="action_actualizar" type="object" string="Actualizar" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="resumen"/></h1>
                        <div class="text-muted">Calculado el <field name="generado" class="oe_inline"/>.
                            Solo lee: para resolver, «Abrir» en cada línea.</div>
                    </div>
                    <!-- v2.6 (19/11/2026): Hoy y Pendiente son del jefe de almacén; IT solo la ve el grupo
                         «KOROSHI: IT» (Departament IT). No vale base.group_system: Almacén Nath también es administrador. -->
                    <notebook>
                        <page string="Hoy" name="hoy">
                            <field name="hoy_ids" nolabel="1">
                                <tree create="false" edit="false" delete="false"
                                      decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                                      decoration-success="semaforo == 'verde'" decoration-muted="semaforo == 'gris'">
                                    <field name="semaforo" invisible="1"/>
                                    <field name="accion" invisible="1"/>
                                    <field name="marca"/>
                                    <field name="que"/>
                                    <field name="cuantos"/>
                                    <field name="detalle"/>
                                    <button name="action_abrir" type="object" string="Abrir" icon="fa-arrow-right"
                                            attrs="{'invisible': [('accion', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pendiente" name="pendiente">
                            <field name="pendiente_ids" nolabel="1">
                                <tree create="false" edit="false" delete="false"
                                      decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                                      decoration-success="semaforo == 'verde'" decoration-muted="semaforo == 'gris'">
                                    <field name="semaforo" invisible="1"/>
                                    <field name="accion" invisible="1"/>
                                    <field name="marca"/>
                                    <field name="que"/>
                                    <field name="cuantos"/>
                                    <field name="detalle"/>
                                    <button name="action_abrir" type="object" string="Abrir" icon="fa-arrow-right"
                                            attrs="{'invisible': [('accion', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="IT" name="it" groups="grupo_it">
                            <div class="text-muted">IT: <field name="resumen_it" class="oe_inline"/></div>
                            <field name="it_ids" nolabel="1">
                                <tree create="false" edit="false" delete="false"
                                      decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                                      decoration-success="semaforo == 'verde'" decoration-muted="semaforo == 'gris'">
                                    <field name="semaforo" invisible="1"/>
                                    <field name="accion" invisible="1"/>
                                    <field name="marca"/>
                                    <field name="que"/>
                                    <field name="cuantos"/>
                                    <field name="detalle"/>
                                    <button name="action_abrir" type="object" string="Abrir" icon="fa-arrow-right"
                                            attrs="{'invisible': [('accion', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_koroshi_bandeja" model="ir.actions.server">
        <field name="name">Bandeja del encargado</field>
        <field name="model_id" ref="model_koroshi_bandeja"/>
        <field name="state">code</field>
        <field name="code">action = model.action_abrir_bandeja()</field>
    </record>

    <!-- v2.4.1: icono propio en la pantalla de aplicaciones, solo para quien esté en este grupo (al actualizar se pone
         el usuario «Almacen 2», almacen2@nath.es: ver __init__.py). Para dárselo a otro: Ajustes › Usuarios › el
         usuario › este grupo. El menú «Hoy › Bandeja del encargado» sigue para todo Inventario. -->
    <record id="grupo_bandeja_app" model="res.groups">
        <field name="name">KOROSHI: Bandeja del encargado en Aplicaciones</field>
        <field name="comment">Ve el icono «Bandeja» en la pantalla de aplicaciones.</field>
    </record>

    <!-- v2.5: jefes de almacén. Ven lo que no es de picking (views/menu.xml). Al instalar o actualizar entran todos los
         usuarios internos de la empresa 8 con Inventario MENOS «Almacén Nath» (almacen@nath.es), que es el de las PDA y
         el picking (ver __init__.py). Los nuevos: Ajustes › Usuarios › el usuario › este grupo. -->
    <record id="grupo_jefes" model="res.groups">
        <field name="name">KOROSHI: Jefes de almacén</field>
        <field name="comment">Ve en la app KOROSHI lo que solo interesa a los jefes: bandeja, previsión, reparto, colas, mapa, revisión de faltantes, Personas, KPI, zonas y Configuración.</field>
    </record>

    <menuitem id="menu_koroshi_bandeja_app" name="Bandeja" sequence="6" action="action_koroshi_bandeja"
              groups="grupo_bandeja_app" web_icon="koroshi_menu,static/description/icon_bandeja.png"/>
</odoo>
