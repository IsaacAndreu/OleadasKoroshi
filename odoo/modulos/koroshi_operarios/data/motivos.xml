<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- v2.0: motivos para "Saltar" en la PDA y adonde va el pedido. Se cambian en
         Inventario > KOROSHI Operarios > Motivos para saltar. -->
    <record id="motivo_sin_stock" model="koroshi.operario.motivo">
        <field name="name">No hay stock / en espera</field>
        <field name="sequence">10</field>
        <field name="destino">oficina</field>
    </record>
    <record id="motivo_material" model="koroshi.operario.motivo">
        <field name="name">Falta material (caja, etiquetas)</field>
        <field name="sequence">20</field>
        <field name="destino">final</field>
    </record>
    <record id="motivo_grande" model="koroshi.operario.motivo">
        <field name="name">Muy grande / que la haga otro</field>
        <field name="sequence">30</field>
        <field name="destino">oficina</field>
    </record>
    <record id="motivo_fin_turno" model="koroshi.operario.motivo">
        <field name="name">Fin de turno (la sigo mañana)</field>
        <field name="sequence">40</field>
        <field name="destino">suya</field>
    </record>
    <record id="motivo_otro" model="koroshi.operario.motivo">
        <field name="name">Otro</field>
        <field name="sequence">50</field>
        <field name="destino">oficina</field>
        <field name="pide_nota" eval="True"/>
    </record>
</odoo>
