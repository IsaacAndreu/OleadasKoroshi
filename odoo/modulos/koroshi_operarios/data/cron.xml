<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cada 5 min: cierra las tareas cuyo pedido o agrupacion ya esta validado y las de dias anteriores.
         v2.19: tambien las que llevan koroshi_operarios.minutos_cierre_inactividad min sin hacer nada, y reabre las
         cerradas asi si el operario ha vuelto a leer. Solo escribe en koroshi.operario.tarea (y el tarea_id de la
         asignacion). -->
    <record id="cron_koroshi_operarios_cerrar" model="ir.cron">
        <field name="name">KOROSHI Operarios: cerrar tareas</field>
        <field name="model_id" ref="model_koroshi_operario_tarea"/>
        <field name="state">code</field>
        <field name="code">model.cron_cerrar(inactividad=True)</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
