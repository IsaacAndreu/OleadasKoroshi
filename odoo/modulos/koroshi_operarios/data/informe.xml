<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.2: informe diario por email. Los parametros no se pisan al actualizar el modulo (noupdate). -->
    <data noupdate="1">
        <record id="param_informe_destinatarios" model="ir.config_parameter">
            <field name="key">koroshi_operarios.informe_destinatarios</field>
            <field name="value">isaac.andreu@nath.es</field>
        </record>
        <record id="param_informe_hora" model="ir.config_parameter">
            <field name="key">koroshi_operarios.informe_hora</field>
            <field name="value">17:00</field>
        </record>
        <record id="param_informe_servidor" model="ir.config_parameter">
            <field name="key">koroshi_operarios.informe_servidor</field>
            <field name="value">NATH</field>
        </record>
    </data>

    <!-- v2.12 (14/11/2026): fuera el cron «KOROSHI Operarios: informe diario por email» (id 204) y la accion
         «Enviar informe de hoy ahora»: el correo diario es solo el de koroshi_informe. Al actualizar, Odoo borra
         los dos registros (no eran noupdate). -->
</odoo>
