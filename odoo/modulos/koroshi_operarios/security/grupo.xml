<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.2: quien ve los nombres con la productividad (Tareas, Productividad, Operarios, informe).
         Los usuarios de la PDA ("Almacen Nath", "Almacen 2") son responsables de inventario: por eso no
         basta con stock.group_stock_manager. Al instalar solo lo tiene el administrador (Departament IT);
         se da a quien haga falta en Ajustes > Usuarios > pestana Permisos > "KOROSHI Operarios". -->
    <record id="grupo_productividad" model="res.groups">
        <field name="name">KOROSHI Operarios: ver productividad</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- v2.2: usuarios que no pueden abrir pedidos en Lecturas (PDA) sin leer antes la tarjeta del operario.
         Al instalar NO tiene a nadie. Para probar, se anade el usuario en Ajustes > Usuarios y companias >
         Grupos > "KOROSHI Operarios: tarjeta obligatoria" > pestana Usuarios (modo desarrollador), y en el
         usuario, Preferencias > Accion inicial = "Operarios". -->
    <record id="grupo_tarjeta_obligatoria" model="res.groups">
        <field name="name">KOROSHI Operarios: tarjeta obligatoria</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
</odoo>
