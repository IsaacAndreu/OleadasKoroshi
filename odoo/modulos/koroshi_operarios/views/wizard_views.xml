<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_koroshi_crear_operarios_form" model="ir.ui.view">
        <field name="name">koroshi.crear.operarios.form</field>
        <field name="model">koroshi.crear.operarios</field>
        <field name="arch" type="xml">
            <form string="Crear operarios">
                <p>Un nombre por linea. Cada operario se crea como empleado (no como usuario de Odoo) con un
                    codigo en "ID de credencial" (OP0001, OP0002...). Despues, en Operarios: marcar «Tarjeta» e
                    «Imprimir tarjetas marcadas».</p>
                <group>
                    <field name="nombres" placeholder="Nombre Apellido&#10;Nombre Apellido"/>
                    <field name="prefijo"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_crear" type="object" string="Crear" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_koroshi_crear_operarios" model="ir.actions.act_window">
        <field name="name">Crear operarios</field>
        <field name="res_model">koroshi.crear.operarios</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
