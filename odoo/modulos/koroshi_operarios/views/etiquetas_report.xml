<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v2.1: hoja con el nombre del operario que va delante de sus etiquetas de zona (mismo papel 4x6) -->
    <record id="paperformat_koroshi_portada" model="report.paperformat">
        <field name="name">KOROSHI 4x6 portada operario</field>
        <field name="format">custom</field>
        <field name="page_height">152</field>
        <field name="page_width">102</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <report id="action_report_portada_operario"
            model="koroshi.operario.asignacion"
            string="KOROSHI Portada operario"
            report_type="qweb-pdf"
            name="koroshi_operarios.report_portada_operario"
            file="koroshi_operarios.report_portada_operario"
            paperformat="paperformat_koroshi_portada"
            menu="False"/>

    <!-- docs = asignaciones de UN operario, en el orden en que las hara -->
    <template id="report_portada_operario">
        <t t-call="web.basic_layout">
            <t t-set="emp" t-value="docs[:1].employee_id"/>
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 0 4mm;">
                <div style="font-size: 9pt; letter-spacing: 2px;">KOROSHI · PEDIDOS DE</div>
                <div style="font-size: 30pt; font-weight: 900; line-height: 1.05; border-bottom: 3px solid #000;
                            padding-bottom: 1mm; white-space: nowrap; overflow: hidden;" t-esc="(emp.name or '').upper()"/>
                <table style="width: 100%; margin-top: 1.5mm;">
                    <tr>
                        <td style="font-size: 22pt; font-weight: 900;"><t t-esc="len(docs)"/> pedidos</td>
                        <td style="text-align: right; font-size: 10pt;" t-esc="docs._ahora_texto()"/>
                    </tr>
                </table>
                <div style="font-size: 9pt; margin: 1mm 0;">Las etiquetas van en este orden. La PDA las abre en el
                    mismo orden.</div>
                <table style="width: 100%; border-collapse: collapse; font-size: 10pt;">
                    <t t-foreach="docs[:16]" t-as="a">
                        <tr style="border-top: 1px solid #000;">
                            <td style="width: 7mm; font-weight: 900;" t-esc="a_index + 1"/>
                            <td style="font-weight: 700; white-space: nowrap;" t-esc="a.name"/>
                            <td style="white-space: nowrap; overflow: hidden; max-width: 40mm; font-size: 8pt;"
                                t-esc="(a.tienda or '')[:28]"/>
                        </tr>
                    </t>
                    <tr t-if="len(docs) &gt; 16">
                        <td colspan="3" style="border-top: 1px solid #000; font-weight: 700;">
                            + <t t-esc="len(docs) - 16"/> más
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <!-- Colas: Accion > Imprimir etiquetas (lo seleccionado; sirve para reimprimir) -->
    <record id="action_koroshi_operario_imprimir_etiquetas" model="ir.actions.server">
        <field name="name">Imprimir etiquetas</field>
        <field name="model_id" ref="model_koroshi_operario_asignacion"/>
        <field name="binding_model_id" ref="model_koroshi_operario_asignacion"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('koroshi_operarios.grupo_productividad'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_imprimir_etiquetas()</field>
    </record>
</odoo>
