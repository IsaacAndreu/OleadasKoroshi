<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parametros (Ajustes > Tecnico > Parametros del sistema). noupdate: al actualizar no se pisan.
         Se instala en modo AVISO: revisa y avisa, pero no aparta nada (los enganches de zonas y operarios devuelven
         una lista vacia). s4t = 1: pregunta el estado al dashboard de S4T (v1.1.0, comprobado el 24/11).
         ultima la escribe el cron. -->
    <data noupdate="1">
        <record id="param_modo" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.modo</field>
            <field name="value">aviso</field>
        </record>
        <record id="param_horas" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.horas</field>
            <field name="value">04:40,05:45</field>
        </record>
        <record id="param_hora_noche" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.hora_noche</field>
            <field name="value">14:00</field>
        </record>
        <record id="param_tipo_pedido" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.tipo_pedido</field>
            <field name="value">PED. TIENDAS</field>
        </record>
        <record id="param_avisar" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.avisar</field>
            <field name="value">isaac.andreu@nath.es</field>
        </record>
        <record id="param_s4t" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.s4t</field>
            <field name="value">1</field>
        </record>
        <!-- v1.1.0 -->
        <record id="param_s4t_limite" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.s4t_limite</field>
            <field name="value">3000</field>
        </record>
        <record id="param_s4t_almacen" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.s4t_almacen</field>
            <field name="value">2</field>
        </record>
        <record id="param_ventana_horas" model="ir.config_parameter">
            <field name="key">koroshi_retener_tiendas.ventana_horas</field>
            <field name="value">3</field>
        </record>
    </data>
</odoo>
