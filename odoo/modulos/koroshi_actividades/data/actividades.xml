<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actividades de partida (13/11/2026). v1.6.0: con su área de la PDA (en una actualización la pone
         migrations/13.0.1.6.0, porque noupdate no las vuelve a escribir). noupdate: si se cambian o archivan en Configuración, al actualizar
         el módulo no se pisan. -->
    <data noupdate="1">
        <record id="actividad_marketplace" model="koroshi.actividad">
            <field name="name">Manipulación marketplace</field>
            <field name="sequence">10</field>
            <field name="color">#0b4f9c</field>
            <field name="area">recepciones</field>  <!-- v1.6.0 -->
        </record>
        <record id="actividad_tiendas" model="koroshi.actividad">
            <field name="name">Tiendas</field>
            <field name="sequence">20</field>
            <field name="color">#1e7b34</field>
            <field name="nota">Etiquetas, alarmas…</field>
            <field name="area">recepciones</field>  <!-- v1.6.0 -->
        </record>
        <record id="actividad_web" model="koroshi.actividad">
            <field name="name">Web</field>
            <field name="sequence">30</field>
            <field name="color">#6b3fa0</field>
            <field name="nota">Etiquetas, alarmas…</field>
            <field name="area">recepciones</field>  <!-- v1.6.0 -->
        </record>
        <record id="actividad_devoluciones" model="koroshi.actividad">
            <field name="name">Manipulación devoluciones</field>
            <field name="sequence">40</field>
            <field name="color">#c25e00</field>
            <field name="area">recepciones</field>  <!-- v1.6.0; v1.8.3: en Recepciones (Devoluciones = Ubicar) -->
        </record>
        <record id="actividad_inversa" model="koroshi.actividad">
            <field name="name">Inversa</field>
            <field name="sequence">50</field>
            <field name="color">#8a5300</field>
            <field name="nota">Lee la matrícula de cada caja</field>
            <field name="pide_matricula" eval="True"/>
            <field name="area">inversa</field>  <!-- v1.6.0 -->
            <field name="abre">koroshi_actividades.action_koroshi_actividades_pantalla</field>
        </record>
        <record id="actividad_bolsas" model="koroshi.actividad">
            <field name="name">Bolsas y etiquetas</field>
            <field name="sequence">60</field>
            <field name="color">#3f4954</field>
            <field name="area">recepciones</field>  <!-- v1.6.0 -->
        </record>
    </data>
</odoo>
