<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: si se cambian en Ajustes > Técnico > Parámetros del sistema, al actualizar no se pisan. -->
    <data noupdate="1">
        <!-- Quien siga trabajando a esta hora queda en pausa a esta hora exacta (comida). '' = no. -->
        <record id="parametro_hora_pausa" model="ir.config_parameter">
            <field name="key">koroshi_actividades.hora_pausa</field>
            <field name="value">13:00</field>
        </record>
        <!-- A esta hora se cierra todo lo que siga abierto (fin de jornada). '' = no. -->
        <record id="parametro_hora_cierre" model="ir.config_parameter">
            <field name="key">koroshi_actividades.hora_cierre</field>
            <field name="value">17:00</field>
        </record>
        <!-- v1.4.0 «¿Sigues?»: desde esta hora, a quien lleva minutos_sigues sin pasar la tarjeta (ni leer una
             matrícula) se le pregunta en el portátil; si en minutos_respuesta nadie la pasa, el tramo se cierra solo.
             sigues_desde '' o minutos_sigues 0 = no se pregunta. -->
        <record id="parametro_sigues_desde" model="ir.config_parameter">
            <field name="key">koroshi_actividades.sigues_desde</field>
            <field name="value">13:00</field>
        </record>
        <record id="parametro_minutos_sigues" model="ir.config_parameter">
            <field name="key">koroshi_actividades.minutos_sigues</field>
            <field name="value">30</field>
        </record>
        <record id="parametro_minutos_respuesta" model="ir.config_parameter">
            <field name="key">koroshi_actividades.minutos_respuesta</field>
            <field name="value">15</field>
        </record>
        <!-- '1' = en el portátil se puede abrir a una persona tocando su nombre en la lista (sin tarjeta). -->
        <record id="parametro_sin_tarjeta" model="ir.config_parameter">
            <field name="key">koroshi_actividades.sin_tarjeta</field>
            <field name="value">0</field>
        </record>
        <!-- v1.1.0: inversa. Palet de la mesa de sorter de cada familia (2 letras del código), para enseñarlo en
             la pantalla al leer la matrícula. Varias familias separadas por espacio; '*' = el resto.
             Propuesta del teórico del 12/11 (bin/versiones/teorico-inversa-KOROSHI_2026-11-12_1658_...). -->
        <record id="parametro_inversa_destinos" model="ir.config_parameter">
            <field name="key">koroshi_actividades.inversa_destinos</field>
            <field name="value">JA=JA, PT=PT, TR=TR, ML=ML, XC ZC UN WA ZT ZB HA ZA BI ZN SG ZF HS=ACC, *=RESTO</field>
        </record>
    </data>
</odoo>
