<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cada 5 min: pausa de la comida (13:00) y cierre de la jornada (17:00) a la hora exacta.
         Solo escribe en koroshi.actividad.registro. -->
    <record id="cron_koroshi_actividades_cerrar" model="ir.cron">
        <field name="name">KOROSHI Actividades: pausa 13:00 y cierre 17:00</field>
        <field name="model_id" ref="model_koroshi_actividad_registro"/>
        <field name="state">code</field>
        <field name="code">model.cron_cerrar()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <!-- v1.8.0: «la lectura manda». Cada 5 min: quien lee una OUT pasa a Picking y quien mueve contenedores a
         Compactación (solo si usa las áreas hoy); en esas dos áreas, 15 min sin leer cierra el tramo.
         Solo escribe en koroshi.actividad.registro (models/lectura_manda.py). -->
    <record id="cron_koroshi_actividades_areas_lectura" model="ir.cron">
        <field name="name">KOROSHI Actividades: área por lectura (PDA)</field>
        <field name="model_id" ref="model_koroshi_actividad_registro"/>
        <field name="state">code</field>
        <field name="code">model.cron_areas_por_lectura()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <!-- v1.1.0: cada 15 min, uds de las cajas de inversa leídas antes de importar su matrícula (últimos 14 días).
         Solo escribe en koroshi.inversa.caja. -->
    <record id="cron_koroshi_inversa_teorico" model="ir.cron">
        <field name="name">KOROSHI Actividades: teórico de las cajas de inversa</field>
        <field name="model_id" ref="model_koroshi_inversa_caja"/>
        <field name="state">code</field>
        <field name="code">model.cron_teorico()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
