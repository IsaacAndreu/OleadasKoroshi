<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ pantalla del portátil -->
    <record id="action_koroshi_actividades_pantalla" model="ir.actions.client">
        <field name="name">Actividades</field>
        <field name="tag">koroshi_actividades_pantalla</field>
    </record>

    <!-- ============================================================ actividades (configuración) -->
    <record id="view_koroshi_actividad_tree" model="ir.ui.view">
        <field name="name">koroshi.actividad.tree</field>
        <field name="model">koroshi.actividad</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="nota"/>
                <field name="color"/>
                <field name="pide_matricula"/>
                <field name="area"/>            <!-- v1.6.0 -->
                <field name="abre"/>
                <field name="en_portatil"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="action_koroshi_actividad" model="ir.actions.act_window">
        <field name="name">Actividades</field>
        <field name="res_model">koroshi.actividad</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p>Botones que salen en el portátil. Para quitar uno sin perder sus horas: Acción &gt; Archivar.</p>
            <p>Con «Área (PDA)» sale en el Inicio de la PDA, dentro de su área; «Abre» es la pantalla que se abre
               después (id externo de la acción). «En el portátil» = sale como botón en el portátil.</p>
        </field>
    </record>

    <!-- ============================================================ tramos -->
    <record id="view_koroshi_actividad_registro_tree" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.tree</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="arch" type="xml">
            <tree decoration-info="estado == 'curso'" decoration-warning="motivo_fin in ('pausa_auto', 'fin_auto', 'sin_respuesta', 'sin_lecturas')">
                <field name="dia"/>
                <field name="employee_id"/>
                <field name="actividad_id"/>
                <field name="inicio"/>
                <field name="fin"/>
                <field name="horas" widget="float_time" sum="Total"/>
                <field name="estado"/>
                <field name="motivo_fin"/>
                <field name="nota" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_koroshi_actividad_registro_form" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.form</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cerrar_a_mano" string="Cerrar ahora" type="object"
                            attrs="{'invisible': [('estado', '!=', 'curso')]}"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="actividad_id"/>
                            <field name="dia"/>
                        </group>
                        <group>
                            <field name="inicio"/>
                            <field name="fin"/>
                            <field name="horas" widget="float_time"/>
                            <field name="motivo_fin"/>
                            <field name="confirmado"/>
                        </group>
                    </group>
                    <field name="nota" placeholder="Nota (p. ej. corregido a mano por…)"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_koroshi_actividad_registro_pivot" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.pivot</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="arch" type="xml">
            <pivot string="Horas por persona y actividad">
                <field name="employee_id" type="row"/>
                <field name="actividad_id" type="col"/>
                <field name="horas" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_koroshi_actividad_registro_graph" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.graph</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="arch" type="xml">
            <graph string="Horas por actividad" type="bar" stacked="True">
                <field name="dia" type="row" interval="day"/>
                <field name="actividad_id" type="col"/>
                <field name="horas" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_koroshi_actividad_registro_search" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.search</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="actividad_id"/>
                <field name="area"/>
                <filter name="hoy" string="Hoy" domain="[('dia', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="semana" string="Últimos 7 días"
                        domain="[('dia', '>=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="curso" string="En curso" domain="[('estado', '=', 'curso')]"/>
                <filter name="auto" string="Cerrados solos (se olvidó)"
                        domain="[('motivo_fin', 'in', ('pausa_auto', 'fin_auto', 'sin_respuesta', 'sin_lecturas'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_persona" string="Persona" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_actividad" string="Actividad" context="{'group_by': 'actividad_id'}"/>
                    <filter name="g_area" string="Área (PDA)" context="{'group_by': 'area'}"/>
                    <filter name="g_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_koroshi_actividad_registro" model="ir.actions.act_window">
        <field name="name">Tramos de tiempo</field>
        <field name="res_model">koroshi.actividad.registro</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="context">{'search_default_hoy': 1}</field>
    </record>
    <!-- v1.6.0: horas por área (entrada única de la PDA). Solo los tramos: las uds y la u/h de picking salen de
         las tareas de koroshi_operarios, que no se suman aquí (serían las mismas horas dos veces). -->
    <record id="view_koroshi_actividad_registro_pivot_area" model="ir.ui.view">
        <field name="name">koroshi.actividad.registro.pivot.area</field>
        <field name="model">koroshi.actividad.registro</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Horas por persona y área">
                <field name="employee_id" type="row"/>
                <field name="area" type="col"/>
                <field name="horas" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_koroshi_actividad_horas_area" model="ir.actions.act_window">
        <field name="name">Horas por área</field>
        <field name="res_model">koroshi.actividad.registro</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="view_id" ref="view_koroshi_actividad_registro_pivot_area"/>
        <field name="context">{'search_default_hoy': 1}</field>
        <field name="help" type="html">
            <p>Horas de cada persona en cada área (Inicio de la PDA y portátil). Las de picking son el rato en el área,
               no la productividad: las uds y la u/h siguen en Productividad.</p>
        </field>
    </record>

    <!-- ============================================================ v1.6.0: Inicio de la PDA -->
    <record id="action_koroshi_inicio_pda" model="ir.actions.client">
        <field name="name">Inicio (PDA)</field>
        <field name="tag">koroshi_actividades_inicio_pda</field>
    </record>
    <record id="view_koroshi_pda_jefe_tree" model="ir.ui.view">
        <field name="name">koroshi.pda.jefe.tree</field>
        <field name="model">koroshi.pda.jefe</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="employee_id"/>
            </tree>
        </field>
    </record>
    <record id="action_koroshi_pda_jefe" model="ir.actions.act_window">
        <field name="name">Jefes en la PDA</field>
        <field name="res_model">koroshi.pda.jefe</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p>Operarios que ven «Gestión» al pasar su tarjeta en el Inicio de la PDA.</p>
        </field>
    </record>
    <record id="view_koroshi_pda_enlace_tree" model="ir.ui.view">
        <field name="name">koroshi.pda.enlace.tree</field>
        <field name="model">koroshi.pda.enlace</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="abre"/>
                <field name="nota"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="action_koroshi_pda_enlace" model="ir.actions.act_window">
        <field name="name">Gestión en la PDA</field>
        <field name="res_model">koroshi.pda.enlace</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p>Botones de «Gestión» en el Inicio de la PDA: id externo de la acción (o su número). Se abren con el
               usuario de la PDA: lo que se ve depende de sus permisos.</p>
        </field>
    </record>

    <record id="action_koroshi_actividad_horas" model="ir.actions.act_window">
        <field name="name">Horas por actividad</field>
        <field name="res_model">koroshi.actividad.registro</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_semana': 1}</field>
    </record>

    <!-- ============================================================ jornada -->
    <record id="view_koroshi_actividad_jornada_tree" model="ir.ui.view">
        <field name="name">koroshi.actividad.jornada.tree</field>
        <field name="model">koroshi.actividad.jornada</field>
        <field name="arch" type="xml">
            <tree decoration-info="abierta" decoration-warning="automatica">
                <field name="dia"/>
                <field name="employee_id"/>
                <field name="entrada"/>
                <field name="salida"/>
                <field name="horas" widget="float_time" sum="Total"/>
                <field name="horas_pausa" widget="float_time"/>
                <field name="actividades"/>
                <field name="tramos" optional="hide"/>
                <field name="abierta"/>
                <field name="automatica"/>
            </tree>
        </field>
    </record>
    <record id="view_koroshi_actividad_jornada_pivot" model="ir.ui.view">
        <field name="name">koroshi.actividad.jornada.pivot</field>
        <field name="model">koroshi.actividad.jornada</field>
        <field name="arch" type="xml">
            <pivot string="Jornada">
                <field name="employee_id" type="row"/>
                <field name="dia" type="col" interval="day"/>
                <field name="horas" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_koroshi_actividad_jornada_search" model="ir.ui.view">
        <field name="name">koroshi.actividad.jornada.search</field>
        <field name="model">koroshi.actividad.jornada</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="hoy" string="Hoy" domain="[('dia', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="semana" string="Últimos 7 días"
                        domain="[('dia', '>=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="auto" string="Se olvidó de pausar o acabar" domain="[('automatica', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_persona" string="Persona" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_koroshi_actividad_jornada" model="ir.actions.act_window">
        <field name="name">Jornada por persona</field>
        <field name="res_model">koroshi.actividad.jornada</field>
        <field name="view_mode">tree,pivot</field>
        <field name="context">{'search_default_semana': 1}</field>
    </record>

    <!-- ============================================================ v1.1.0: inversa (cajas leídas) -->
    <record id="view_koroshi_inversa_caja_tree" model="ir.ui.view">
        <field name="name">koroshi.inversa.caja.tree</field>
        <field name="model">koroshi.inversa.caja</field>
        <field name="arch" type="xml">
            <tree decoration-info="estado == 'abierta'" decoration-muted="estado == 'anulada'"
                  decoration-warning="not teorico and estado != 'anulada'">
                <field name="dia"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="inicio"/>
                <field name="fin"/>
                <field name="minutos" sum="Total"/>
                <field name="uds" sum="Total"/>
                <field name="skus" optional="hide"/>
                <field name="familias"/>
                <field name="teorico"/>
                <field name="repetida" optional="hide"/>
                <field name="estado"/>
                <field name="motivo_fin" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_koroshi_inversa_caja_form" model="ir.ui.view">
        <field name="name">koroshi.inversa.caja.form</field>
        <field name="model">koroshi.inversa.caja</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cerrar_a_mano" string="Cerrar ahora" type="object"
                            attrs="{'invisible': [('estado', '!=', 'abierta')]}"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="dia"/>
                            <field name="registro_id"/>
                        </group>
                        <group>
                            <field name="inicio"/>
                            <field name="fin"/>
                            <field name="minutos"/>
                            <field name="motivo_fin"/>
                        </group>
                        <group string="Teórico">
                            <field name="teorico"/>
                            <field name="uds"/>
                            <field name="skus"/>
                            <field name="familias"/>
                            <field name="repetida"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_koroshi_inversa_caja_pivot" model="ir.ui.view">
        <field name="name">koroshi.inversa.caja.pivot</field>
        <field name="model">koroshi.inversa.caja</field>
        <field name="arch" type="xml">
            <pivot string="Cajas de inversa por persona y día">
                <field name="employee_id" type="row"/>
                <field name="dia" type="col" interval="day"/>
                <field name="uds" type="measure"/>
                <field name="minutos" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_koroshi_inversa_caja_graph" model="ir.ui.view">
        <field name="name">koroshi.inversa.caja.graph</field>
        <field name="model">koroshi.inversa.caja</field>
        <field name="arch" type="xml">
            <graph string="Cajas por persona" type="bar">
                <field name="employee_id" type="row"/>
            </graph>
        </field>
    </record>
    <record id="view_koroshi_inversa_caja_search" model="ir.ui.view">
        <field name="name">koroshi.inversa.caja.search</field>
        <field name="model">koroshi.inversa.caja</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="hoy" string="Hoy" domain="[('dia', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="semana" string="Últimos 7 días"
                        domain="[('dia', '>=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="validas" string="Sin anuladas" domain="[('estado', '!=', 'anulada')]"/>
                <filter name="sin_teorico" string="Sin teórico" domain="[('teorico', '=', False)]"/>
                <filter name="repetidas" string="Leídas otra vez" domain="[('repetida', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_persona" string="Persona" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                    <filter name="g_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_koroshi_inversa_caja" model="ir.actions.act_window">
        <field name="name">Inversa: cajas leídas</field>
        <field name="res_model">koroshi.inversa.caja</field>
        <field name="view_mode">pivot,tree,graph,form</field>
        <field name="context">{'search_default_hoy': 1, 'search_default_validas': 1}</field>
        <field name="help" type="html">
            <p>Cada caja de tienda que se abre en la inversa. La tabla dinámica cuenta cajas (Recuento), uds del
               teórico y minutos por persona y día.</p>
        </field>
    </record>
</odoo>
