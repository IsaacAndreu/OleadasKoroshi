<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v2.3: salida automatica del operario por inactividad en la PDA (minutos). 0 = desactivado.
         noupdate: si se cambia en Ajustes > Tecnico > Parametros del sistema, al actualizar no se pisa. -->
    <data noupdate="1">
        <record id="parametro_minutos_inactividad" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.minutos_inactividad</field>
            <field name="value">0</field>
        </record>
        <!-- v2.5: OUT sueltas con al menos estas uds salen como «para hacer a dos» en Colas. 0 = nunca. -->
        <record id="parametro_uds_a_dos" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.uds_a_dos</field>
            <field name="value">150</field>
        </record>
        <!-- v2.8: minutos sin leer nada para que un pedido abierto deje de contar como «lo esta haciendo ahora»:
             quien lo lee se lo queda sin preguntar «¿Unirte a X?» y el monitor lo marca en rojo. -->
        <record id="parametro_minutos_sin_leer" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.minutos_sin_leer</field>
            <field name="value">15</field>
        </record>
        <!-- v2.19: minutos sin hacer nada para que el cron cierre sola la tarea en curso (dejada, inactividad), a la
             hora de su ultima actividad: no cuenta para las u/h. No toca el pedido. 0 = nunca. -->
        <record id="parametro_minutos_cierre_inactividad" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.minutos_cierre_inactividad</field>
            <field name="value">15</field>
        </record>
        <!-- v2.22.1: minutos sin actividad que dura la tarjeta compartida en Contenedores y Faltante (Lecturas va
             por minutos_inactividad). Lo pidio Isaac el 20/11: con 15 caducaba demasiado rapido. -->
        <record id="parametro_minutos_tarjeta" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.minutos_tarjeta</field>
            <field name="value">60</field>
        </record>
        <!-- 1.0.2 (28/11): tipos de pedido que van por oleada (INT al SORTER y PedidosMultiples) en cada almacén:
             «CÓDIGO=tipo,tipo; CÓDIGO=tipo». Sus OUT no se dan en la PDA. Un almacén que no sale, todo directo. -->
        <record id="parametro_oleadas" model="ir.config_parameter">
            <field name="key">tuctuc_operarios.oleadas</field>
            <field name="value">WH-OR=WEB,WEB B&amp;B,PED. INICIAL; MODAI=WEB,WEB B&amp;B</field>
        </record>
    </data>
</odoo>
