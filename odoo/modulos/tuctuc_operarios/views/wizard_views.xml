<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuctuc_crear_operarios_form" model="ir.ui.view">
        <field name="name">tuctuc.crear.operarios.form</field>
        <field name="model">tuctuc.crear.operarios</field>
        <field name="arch" type="xml">
            <form string="Crear operarios">
                <p>Un operario por línea. Se crea como empleado (no como usuario de Odoo) con su código en «ID de
                    credencial». <b>La misma tarjeta vale aquí y en NATH</b>: escribe delante el código de su tarjeta
                    de NATH (<code>OP0007 Nombre Apellido</code>). Sin código, se le da el siguiente libre: entonces
                    hay que darlo de alta en NATH con ese mismo código.</p>
                <group>
                    <field name="nombres" placeholder="OP0007 Nombre Apellido&#10;OP0012 Nombre Apellido"/>
                    <field name="prefijo"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_crear" type="object" string="Crear" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tuctuc_crear_operarios" model="ir.actions.act_window">
        <field name="name">Crear operarios</field>
        <field name="res_model">tuctuc.crear.operarios</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
