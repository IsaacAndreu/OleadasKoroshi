<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="koroshi_juntar_cajas.Pantalla">
        <div class="o_koroshi_juntar_cajas">
            <header class="o_kjc_cab">
                <div class="o_kjc_titulo">Juntar cajas</div>
                <input type="text" class="o_kjc_codigo" autocomplete="off" inputmode="none"
                       placeholder="Leer la caja (CJ) o tu tarjeta"/>
                <button type="button" class="o_kjc_teclado">⌨ Escribir</button>
            </header>
            <div class="o_kjc_quien"/>
            <div class="o_kjc_aviso"/>
            <div class="o_kjc_cuerpo"/>
        </div>
    </t>
    <!-- v1.1.0: «Revisar caja» (mismo aspecto) -->
    <t t-name="koroshi_juntar_cajas.Revisar">
        <div class="o_koroshi_juntar_cajas">
            <header class="o_kjc_cab">
                <div class="o_kjc_titulo">Revisar caja</div>
                <input type="text" class="o_kjc_codigo" autocomplete="off" inputmode="none"
                       placeholder="Leer la caja (CJ), la prenda o tu tarjeta"/>
                <button type="button" class="o_kjc_teclado">⌨ Escribir</button>
            </header>
            <div class="o_kjc_quien"/>
            <div class="o_kjc_aviso"/>
            <div class="o_kjc_cuerpo"/>
        </div>
    </t>
</templates>
