<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.0.0: solo Departament IT (id 2) para probar. Después: el id del usuario de las PDA, o * para todos. -->
    <data noupdate="1">
        <record id="param_usuarios" model="ir.config_parameter">
            <field name="key">koroshi_pda_app.usuarios</field>
            <field name="value">2</field>
        </record>
        <!-- v1.2.0: dónde abre la app. 'lecturas' = como hasta ahora; 'areas' = el Inicio de la PDA por áreas
             (koroshi_actividades 1.6.0). Se cambia en Parámetros del sistema cuando el Inicio esté probado. -->
        <record id="param_inicio" model="ir.config_parameter">
            <field name="key">koroshi_pda_app.inicio</field>
            <field name="value">lecturas</field>
        </record>
    </data>
</odoo>
