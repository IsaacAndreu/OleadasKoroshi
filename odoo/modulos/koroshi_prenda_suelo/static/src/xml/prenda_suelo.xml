<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="koroshi_prenda_suelo.Pantalla">
        <div class="o_koroshi_prenda_suelo">
            <header class="o_kps_cab">
                <div class="o_kps_titulo">Prenda en el suelo</div>
                <input type="text" class="o_kps_codigo" autocomplete="off" inputmode="none"
                       placeholder="Leer la prenda (o el hueco, o tu tarjeta)"/>
                <button type="button" class="o_kps_teclado">⌨ Escribir</button>
            </header>
            <div class="o_kps_quien"/>
            <div class="o_kps_aviso"/>
            <div class="o_kps_cuerpo"/>
            <div class="o_kps_botones">
                <button type="button" class="o_kps_vaciar">Otra prenda</button>
            </div>
        </div>
    </t>
</templates>
