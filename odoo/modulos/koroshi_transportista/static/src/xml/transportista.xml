<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="koroshi_transportista.Pantalla">
        <div class="o_koroshi_transportista">
            <!-- v1.1.1: un formulario: el Intro/«Ir» del teclado de Android lo envía aunque no llegue como tecla 13 -->
            <form class="o_ktr_cab o_ktr_form" action="#" autocomplete="off">
                <div class="o_ktr_titulo">Transportista</div>
                <input type="text" class="o_ktr_codigo" autocomplete="off" inputmode="none" enterkeyhint="go"
                       placeholder="Leer la caja (CJ), sus 4 últimas cifras o tu tarjeta"/>
                <button type="submit" class="o_ktr_leer">✓ Leer</button>
                <button type="button" class="o_ktr_teclado">⌨ Escribir</button>
            </form>
            <div class="o_ktr_fila">
                <div class="o_ktr_quien"/>
                <div class="o_ktr_elegir">
                    <button type="button" class="o_ktr_tr" data-tr="gls">GLS</button>
                    <button type="button" class="o_ktr_tr" data-tr="xpo">XPO</button>
                </div>
            </div>
            <div class="o_ktr_aviso"/>
            <div class="o_ktr_cuerpo"/>
            <!-- v1.7.0: lista fija de las expediciones de hoy para reimprimir -->
            <div class="o_ktr_expediciones"/>
        </div>
    </t>
</templates>
