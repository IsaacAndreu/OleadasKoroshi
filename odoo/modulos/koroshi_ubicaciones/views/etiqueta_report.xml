<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zebra 4x6 (102 x 152 mm), la misma de las etiquetas de pedido. Una etiqueta por hueco o contenedor. -->
    <record id="paperformat_koroshi_ubicacion" model="report.paperformat">
        <field name="name">KOROSHI 4x6 ubicación (hueco o contenedor)</field>
        <field name="format">custom</field>
        <field name="page_height">152</field>
        <field name="page_width">102</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">4</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <report id="action_etiqueta_ubicacion"
            model="stock.location"
            string="KOROSHI Etiqueta 4x6 (hueco o contenedor)"
            report_type="qweb-pdf"
            name="koroshi_ubicaciones.etiqueta_ubicacion"
            file="koroshi_ubicaciones.etiqueta_ubicacion"
            paperformat="paperformat_koroshi_ubicacion"
            print_report_name="'Etiquetas'"
            menu="False"/>

    <template id="etiqueta_ubicacion">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="loc">
                <t t-set="et" t-value="etiqueta(loc)"/>
                <div t-if="not loc_first" style="page-break-before: always;"/>
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 0 4mm;
                                         text-align: center;">
                    <div style="font-size: 11pt; letter-spacing: 3px;" t-esc="et['arriba']"/>
                    <t t-if="et['tipo'] == 'hueco'">
                        <div style="font-size: 72pt; font-weight: 900; line-height: 1.0;" t-esc="et['grande']"/>
                        <div style="font-size: 40pt; font-weight: 900; line-height: 1.1; margin-bottom: 4mm;"
                             t-esc="et['medio']"/>
                    </t>
                    <t t-else="">
                        <div style="font-size: 30pt; font-weight: 900; line-height: 1.1; margin: 8mm 0 8mm 0;
                                    white-space: nowrap;" t-esc="et['grande']"/>
                    </t>
                    <img alt="codigo" t-att-src="et['url']" style="width: 92mm; height: 30mm;"/>
                    <div style="font-size: 16pt; font-weight: 700; margin-top: 1mm;" t-esc="et['codigo']"/>
                    <div t-if="et['sin_codigo']" style="font-size: 8pt; margin-top: 2mm;">
                        (esta ubicación no tiene código de barras en Odoo: el código es su nombre)
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
