<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La primera impresora: la Zebra 4x6 del portátil de Expediciones (Isaac, 25/11: una ZD420 o parecida).
         Es un <record>, no un <function>: se crea al instalar. noupdate: si se cambia a mano, no se pisa. -->
    <data noupdate="1">
        <record id="impresora_expediciones" model="koroshi.impresora">
            <field name="name">Zebra Expediciones</field>
            <field name="codigo">EXP1</field>
            <field name="puesto">Portátil de Expediciones</field>
        </record>

        <record id="cron_limpiar_trabajos" model="ir.cron">
            <field name="name">KOROSHI Impresión: borrar trabajos impresos de más de 30 días</field>
            <field name="model_id" ref="model_koroshi_impresion_trabajo"/>
            <field name="state">code</field>
            <field name="code">model._cron_limpiar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
