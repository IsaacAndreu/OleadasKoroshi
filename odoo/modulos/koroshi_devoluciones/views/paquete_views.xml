<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.1.0: paquetes de devolución llegados (fase 2, etapa 1). Buscar «lo de GLS del día 28». -->
    <record id="view_koroshi_devolucion_paquete_tree" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.tree</field>
        <field name="model">koroshi.devolucion.paquete</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" decoration-muted="estado == 'anulado'">
                <field name="llegada"/>
                <field name="name"/>
                <field name="canal"/>
                <field name="tipo_codigo" optional="show"/>
                <field name="tienda_id" optional="show"/>
                <field name="employee_id"/>
                <field name="uds_leidas" optional="show" sum="Uds"/>
                <field name="uds_bien" optional="hide" sum="Bien"/>
                <field name="uds_manipular" optional="hide" sum="Manipular"/>
                <field name="uds_tara" optional="hide" sum="Tara"/>
                <field name="nota" optional="show"/>
                <field name="dia" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_koroshi_devolucion_paquete_form" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.form</field>
        <field name="model">koroshi.devolucion.paquete</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_anular" type="object" string="Anular (leído por error)"
                            groups="stock.group_stock_manager" attrs="{'invisible': [('estado', '!=', 'llegado')]}"
                            confirm="La llegada queda anulada (no se borra). ¿Seguro?"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="canal"/>
                            <field name="tipo_codigo"/>
                            <field name="tienda_id"/>
                        </group>
                        <group>
                            <field name="llegada"/>
                            <field name="dia"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="nota" placeholder="Nota"/>
                    <group string="Contenido leído (v1.2)">
                        <group>
                            <field name="uds_leidas"/>
                            <field name="uds_bien"/>
                        </group>
                        <group>
                            <field name="uds_manipular"/>
                            <field name="uds_tara"/>
                        </group>
                    </group>
                    <field name="linea_ids">
                        <tree>
                            <field name="product_id"/>
                            <field name="uds" sum="Uds"/>
                            <field name="resultado"/>
                            <field name="manipulacion_id"/>
                            <field name="employee_id"/>
                            <field name="fecha"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_koroshi_devolucion_paquete_pivot" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.pivot</field>
        <field name="model">koroshi.devolucion.paquete</field>
        <field name="arch" type="xml">
            <pivot string="Paquetes llegados">
                <field name="dia" interval="day" type="row"/>
                <field name="canal" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_koroshi_devolucion_paquete_search" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.search</field>
        <field name="model">koroshi.devolucion.paquete</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Código (matrícula, Zalando, transportista)"/>
                <field name="tienda_id"/>
                <field name="employee_id"/>
                <field name="nota"/>
                <filter name="llegados" string="Llegados" domain="[('estado', 'in', ('llegado', 'leido'))]"/>
                <filter name="sin_leer" string="Sin leer el contenido" domain="[('estado', '=', 'llegado')]"/>
                <filter name="leidos" string="Contenido leído" domain="[('estado', '=', 'leido')]"/>
                <filter name="anulados" string="Anulados" domain="[('estado', '=', 'anulado')]"/>
                <separator/>
                <filter name="tienda" string="Tiendas" domain="[('canal', '=', 'tienda')]"/>
                <filter name="web" string="Web" domain="[('canal', '=', 'web')]"/>
                <filter name="zalando" string="Zalando" domain="[('canal', '=', 'zalando')]"/>
                <filter name="marketplace" string="Marketplace" domain="[('canal', '=', 'marketplace')]"/>
                <separator/>
                <filter name="filtro_dia" string="Día de llegada" date="dia"/>
                <filter name="hoy" string="Hoy" domain="[('dia', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                    <filter name="por_canal" string="Canal" context="{'group_by': 'canal'}"/>
                    <filter name="por_tienda" string="Tienda" context="{'group_by': 'tienda_id'}"/>
                    <filter name="por_persona" string="Leído por" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_koroshi_devolucion_paquete" model="ir.actions.act_window">
        <field name="name">Paquetes llegados</field>
        <field name="res_model">koroshi.devolucion.paquete</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="context">{'search_default_llegados': 1}</field>
    </record>

    <menuitem id="menu_koroshi_devoluciones_paquetes" name="Paquetes llegados"
              parent="menu_koroshi_devoluciones_root" action="action_koroshi_devolucion_paquete" sequence="15"/>

    <!-- v1.2.0: prendas leídas dentro de los paquetes (lo que «les mandamos» si no nos lo pasan) -->
    <record id="view_koroshi_devolucion_paquete_linea_tree" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.linea.tree</field>
        <field name="model">koroshi.devolucion.paquete.linea</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="fecha"/>
                <field name="paquete_id"/>
                <field name="canal"/>
                <field name="product_id"/>
                <field name="uds" sum="Uds"/>
                <field name="resultado"/>
                <field name="manipulacion_id"/>
                <field name="employee_id"/>
                <field name="dia" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_koroshi_devolucion_paquete_linea_pivot" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.linea.pivot</field>
        <field name="model">koroshi.devolucion.paquete.linea</field>
        <field name="arch" type="xml">
            <pivot string="Prendas leídas en paquetes">
                <field name="dia" interval="day" type="row"/>
                <field name="resultado" type="col"/>
                <field name="uds" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_koroshi_devolucion_paquete_linea_search" model="ir.ui.view">
        <field name="name">koroshi.devolucion.paquete.linea.search</field>
        <field name="model">koroshi.devolucion.paquete.linea</field>
        <field name="arch" type="xml">
            <search>
                <field name="paquete_id"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <filter name="bien" string="Bien" domain="[('resultado', '=', 'bien')]"/>
                <filter name="manipular" string="Manipular" domain="[('resultado', '=', 'manipular')]"/>
                <filter name="tara" string="Tara" domain="[('resultado', '=', 'tara')]"/>
                <separator/>
                <filter name="filtro_dia" string="Día" date="dia"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_paquete" string="Paquete" context="{'group_by': 'paquete_id'}"/>
                    <filter name="por_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                    <filter name="por_canal" string="Canal" context="{'group_by': 'canal'}"/>
                    <filter name="por_resultado" string="Resultado" context="{'group_by': 'resultado'}"/>
                    <filter name="por_manipulacion" string="Manipulación" context="{'group_by': 'manipulacion_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_koroshi_devolucion_paquete_linea" model="ir.actions.act_window">
        <field name="name">Prendas leídas en paquetes</field>
        <field name="res_model">koroshi.devolucion.paquete.linea</field>
        <field name="view_mode">tree,pivot</field>
    </record>

    <menuitem id="menu_koroshi_devoluciones_paquete_lineas" name="Prendas leídas en paquetes"
              parent="menu_koroshi_devoluciones_root" action="action_koroshi_devolucion_paquete_linea" sequence="16"/>
</odoo>
