<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pantalla de la PDA -->
    <record id="action_koroshi_devoluciones_pantalla" model="ir.actions.client">
        <field name="name">Ubicar devoluciones</field>
        <field name="tag">koroshi_devoluciones_pantalla</field>
    </record>

    <!-- Prendas ubicadas -->
    <record id="view_koroshi_devolucion_ubicada_tree" model="ir.ui.view">
        <field name="name">koroshi.devolucion.ubicada.tree</field>
        <field name="model">koroshi.devolucion.ubicada</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false" decoration-muted="estado == 'anulada'">
                <field name="fecha"/>
                <field name="dia" optional="hide"/>
                <field name="employee_id"/>
                <field name="manipulacion_id"/>
                <field name="codigo_factura" optional="show"/>
                <field name="product_id"/>
                <field name="uds" sum="Uds"/>
                <field name="ubicacion"/>
                <field name="ubicacion_id" optional="hide"/>
                <field name="stock" optional="hide"/>
                <field name="uds_devoluciones" optional="hide" sum="Desde devoluciones"/>
                <field name="uds_nuevas" optional="hide" sum="Nuevas"/>
                <field name="tanda" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_koroshi_devolucion_ubicada_form" model="ir.ui.view">
        <field name="name">koroshi.devolucion.ubicada.form</field>
        <field name="model">koroshi.devolucion.ubicada</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_anular" type="object" string="Anular la tanda" groups="stock.group_stock_manager"
                            attrs="{'invisible': [('estado', '!=', 'hecha')]}"
                            confirm="Se anula la tanda entera y, si se movió stock, vuelve a donde estaba. ¿Seguro?"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tanda"/>
                            <field name="fecha"/>
                            <field name="dia"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="manipulacion_id"/>
                            <field name="codigo_factura"/>
                            <field name="product_id"/>
                            <field name="uds"/>
                            <field name="ubicacion_id"/>
                        </group>
                        <group string="Stock">
                            <field name="stock"/>
                            <field name="uds_devoluciones"/>
                            <field name="uds_nuevas"/>
                            <field name="move_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Anulada" attrs="{'invisible': [('estado', '!=', 'anulada')]}">
                            <field name="anulada_por"/>
                            <field name="anulada_el"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_koroshi_devolucion_ubicada_pivot" model="ir.ui.view">
        <field name="name">koroshi.devolucion.ubicada.pivot</field>
        <field name="model">koroshi.devolucion.ubicada</field>
        <field name="arch" type="xml">
            <pivot string="Devoluciones ubicadas">
                <field name="dia" interval="day" type="row"/>
                <field name="manipulacion_id" type="col"/>
                <field name="uds" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_koroshi_devolucion_ubicada_graph" model="ir.ui.view">
        <field name="name">koroshi.devolucion.ubicada.graph</field>
        <field name="model">koroshi.devolucion.ubicada</field>
        <field name="arch" type="xml">
            <graph string="Devoluciones ubicadas" type="bar" stacked="True">
                <field name="dia" interval="day" type="row"/>
                <field name="manipulacion_id" type="col"/>
                <field name="uds" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_koroshi_devolucion_ubicada_search" model="ir.ui.view">
        <field name="name">koroshi.devolucion.ubicada.search</field>
        <field name="model">koroshi.devolucion.ubicada</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="ubicacion"/>
                <field name="employee_id"/>
                <field name="manipulacion_id"/>
                <field name="tanda"/>
                <filter name="hechas" string="Hechas" domain="[('estado', '=', 'hecha')]"/>
                <filter name="anuladas" string="Anuladas" domain="[('estado', '=', 'anulada')]"/>
                <separator/>
                <filter name="filtro_dia" string="Día" date="dia"/>
                <filter name="hoy" string="Hoy" domain="[('dia', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_dia" string="Día" context="{'group_by': 'dia:day'}"/>
                    <filter name="por_semana" string="Semana" context="{'group_by': 'dia:week'}"/>
                    <filter name="por_mes" string="Mes" context="{'group_by': 'dia:month'}"/>
                    <filter name="por_manipulacion" string="Manipulación" context="{'group_by': 'manipulacion_id'}"/>
                    <filter name="por_codigo" string="Código de factura" context="{'group_by': 'codigo_factura'}"/>
                    <filter name="por_persona" string="Operario" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_koroshi_devolucion_ubicada" model="ir.actions.act_window">
        <field name="name">Devoluciones ubicadas</field>
        <field name="res_model">koroshi.devolucion.ubicada</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_hechas': 1}</field>
    </record>

    <!-- Informe: pivote por día (se cambia a semana o mes en la cabecera de filas) y manipulación -->
    <record id="action_koroshi_devolucion_informe" model="ir.actions.act_window">
        <field name="name">Informe de devoluciones</field>
        <field name="res_model">koroshi.devolucion.ubicada</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_hechas': 1, 'search_default_filtro_dia': 1}</field>
    </record>

    <!-- Opciones de manipulación (las edita un jefe) -->
    <record id="view_koroshi_devolucion_manipulacion_tree" model="ir.ui.view">
        <field name="name">koroshi.devolucion.manipulacion.tree</field>
        <field name="model">koroshi.devolucion.manipulacion</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="codigo_factura"/>
                <field name="color"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_koroshi_devolucion_manipulacion" model="ir.actions.act_window">
        <field name="name">Opciones de manipulación</field>
        <field name="res_model">koroshi.devolucion.manipulacion</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
