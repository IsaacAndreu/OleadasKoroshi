        <div class="o_koroshi_devoluciones">
            <header class="o_kd_cab">
                <div class="o_kd_titulo">Devoluciones</div>
                <input type="text" class="o_kd_codigo" autocomplete="off" inputmode="none"
                       placeholder="Tarjeta, prenda, contenedor o paquete"/>
