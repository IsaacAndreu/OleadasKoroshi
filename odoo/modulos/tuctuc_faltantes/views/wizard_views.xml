<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuctuc_faltante_encontrado_form" model="ir.ui.view">
        <field name="name">tuctuc.faltante.encontrado.form</field>
        <field name="model">tuctuc.faltante.encontrado</field>
        <field name="arch" type="xml">
            <form string="Encontrado">
                <p>Las uds de FALTANTE de estos faltantes vuelven a la ubicacion que elijas.</p>
                <group>
                    <field name="ubicacion_id" options="{'no_create': True}"/>
                    <field name="faltante_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object" string="Devolver" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
