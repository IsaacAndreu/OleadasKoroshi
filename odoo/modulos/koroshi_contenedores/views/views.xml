<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_koroshi_contenedores_pantalla" model="ir.actions.client">
        <field name="name">Contenedores</field>
        <field name="tag">koroshi_contenedores_pantalla</field>
    </record>

    <record id="view_koroshi_contenedor_mov_tree" model="ir.ui.view">
        <field name="name">koroshi.contenedor.movimiento.tree</field>
        <field name="model">koroshi.contenedor.movimiento</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="create_date" string="Cuándo"/>
                <field name="accion"/>
                <field name="employee_id"/>
                <field name="user_id" optional="hide"/>
                <field name="contenedor"/>
                <field name="producto_id" optional="show"/>
                <field name="producto_nuevo_id" optional="show"/>
                <field name="origen"/>
                <field name="destino"/>
                <field name="lineas"/>
                <field name="uds"/>
                <field name="reservadas"/>
                <field name="move_id" optional="hide"/>
                <field name="move_nuevo_id" optional="hide"/>
                <field name="faltante_id" optional="hide"/>
                <field name="tanda" optional="hide"/>
            </tree>
        </field>
    </record>
    <!-- v1.5: buscar por contenedor, artículo, persona y acción (los ajustes de stock: «Poner a cero» / «Añadir») -->
    <record id="view_koroshi_contenedor_mov_search" model="ir.ui.view">
        <field name="name">koroshi.contenedor.movimiento.search</field>
        <field name="model">koroshi.contenedor.movimiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="contenedor"/>
                <field name="producto_id"/>
                <field name="producto_nuevo_id"/>
                <field name="employee_id"/>
                <filter name="ajustes" string="Ajustes de stock (a cero / añadir / cantidad / a Faltantes / es otro)"
                        domain="[('accion', 'in', ('cero', 'anadir', 'cantidad', 'faltante', 'cambiar_articulo'))]"/>
                <filter name="faltantes" string="A Faltantes" domain="[('accion', '=', 'faltante')]"/>
                <filter name="cambiar_articulo" string="Cambiar artículo (errores de talla)"
                        domain="[('accion', '=', 'cambiar_articulo')]"/>
                <filter name="hoy" string="Hoy"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_accion" string="Acción" context="{'group_by': 'accion'}"/>
                    <filter name="por_persona" string="Persona" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_koroshi_contenedor_mov" model="ir.actions.act_window">
        <field name="name">Movimientos de contenedores</field>
        <field name="res_model">koroshi.contenedor.movimiento</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
