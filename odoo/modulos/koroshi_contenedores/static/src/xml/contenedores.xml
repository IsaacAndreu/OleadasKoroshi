<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="koroshi_contenedores.Pantalla">
        <div class="o_koroshi_contenedores">
            <header class="o_kc_cab">
                <div class="o_kc_titulo">Contenedores</div>
                <input type="text" class="o_kc_codigo" autocomplete="off" inputmode="none"
                       placeholder="Contenedor, ubicación, lineal (L94) o artículo: código o un trozo"/>
                <button type="button" class="o_kc_teclado">⌨ Escribir</button>
            </header>
            <div class="o_kc_sugerencias"/>
            <div class="o_kc_persona"/>
            <div class="o_kc_aviso"/>
            <div class="o_kc_paso"/>
            <div class="o_kc_lista"/>
            <div class="o_kc_hueco_panel"/>
            <div class="o_kc_botones">
                <button type="button" class="o_kc_atras">← Atrás</button>
                <button type="button" class="o_kc_ronda">Retirar cajas a 0</button>
                <button type="button" class="o_kc_compactar">Compactar</button>
                <button type="button" class="o_kc_vaciar">Empezar de nuevo</button>
            </div>
        </div>
    </t>
</templates>
