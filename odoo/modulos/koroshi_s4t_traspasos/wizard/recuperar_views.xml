<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traspaso_recuperar_form" model="ir.ui.view">
        <field name="name">koroshi.s4t.traspaso.recuperar.form</field>
        <field name="model">koroshi.s4t.traspaso.recuperar</field>
        <field name="arch" type="xml">
            <form string="Recuperar traspasos de un dia">
                <p>Vuelve a pedir a S4T los traspasos de ese dia y guarda solo los que aun no esten en Odoo.</p>
                <group>
                    <field name="tipo"/>
                    <field name="fecha"/>
                </group>
                <footer>
                    <button name="action_recuperar" type="object" string="Recuperar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_traspaso_recuperar" model="ir.actions.act_window">
        <field name="name">Recuperar traspasos S4T de un dia</field>
        <field name="res_model">koroshi.s4t.traspaso.recuperar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_traspaso_recuperar" name="Recuperar traspasos S4T" parent="stock.menu_stock_warehouse_mgmt"
              action="action_traspaso_recuperar" sequence="92" groups="stock.group_stock_manager"/>
</odoo>
