<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- v1.3: al instalar, modo 'guardar' (descarga y guarda, no crea DEV). Para crear DEV: poner 'real'. -->
        <record id="param_modo" model="ir.config_parameter">
            <field name="key">koroshi_s4t_traspasos.modo</field>
            <field name="value">guardar</field>
        </record>
        <!-- v1.4.0 (R12): a quien va el correo diario con los traspasos en error. Separados por comas. -->
        <record id="param_avisar" model="ir.config_parameter">
            <field name="key">koroshi_s4t_traspasos.avisar</field>
            <field name="value">isaac.andreu@nath.es</field>
        </record>
        <!-- Cron ARCHIVADO (inactivo). Primera descarga: "Ejecutar manualmente", revisar, y despues activarlo. -->
        <record id="cron_traspasos_s4t" model="ir.cron">
            <field name="name">KOROSHI - Traspasos S4T (devoluciones y correcciones)</field>
            <field name="model_id" ref="model_koroshi_s4t_traspaso"/>
            <field name="state">code</field>
            <field name="code">model.cron_traspasos()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
