<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traspaso_tree" model="ir.ui.view">
        <field name="name">koroshi.s4t.traspaso.tree</field>
        <field name="model">koroshi.s4t.traspaso</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'error'" decoration-success="state in ('recepcion', 'registrado')"
                  decoration-info="state == 'nuevo'">
                <field name="tipo"/>
                <field name="name"/>
                <field name="transfer_date"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="tienda_id"/>
                <field name="transfer_type"/>
                <field name="total_quantity" sum="Unidades"/>
                <field name="picking_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_traspaso_form" model="ir.ui.view">
        <field name="name">koroshi.s4t.traspaso.form</field>
        <field name="model">koroshi.s4t.traspaso</field>
        <field name="arch" type="xml">
            <form string="Traspaso S4T" create="false">
                <header>
                    <button name="action_procesar" type="object" string="Procesar" class="btn-primary"
                            groups="stock.group_stock_manager"
                            attrs="{'invisible': [('state', 'not in', ('nuevo', 'error'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="transfer_type"/>
                            <field name="status"/>
                            <field name="transfer_date"/>
                            <field name="total_quantity"/>
                        </group>
                        <group>
                            <field name="origin_id"/>
                            <field name="destination_id"/>
                            <field name="tienda_id"/>
                            <field name="warehouse_id_s4t"/>
                            <field name="operator_id"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                    <group string="Error" attrs="{'invisible': [('error', '=', False)]}">
                        <field name="error" nolabel="1"/>
                    </group>
                    <field name="line_ids">
                        <tree>
                            <field name="line_number"/>
                            <field name="sku"/>
                            <field name="product_id"/>
                            <field name="quantity" sum="Unidades"/>
                            <field name="boxes"/>
                        </tree>
                    </field>
                    <group string="JSON recibido de S4T">
                        <field name="datos" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_traspaso_search" model="ir.ui.view">
        <field name="name">koroshi.s4t.traspaso.search</field>
        <field name="model">koroshi.s4t.traspaso</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tienda_id"/>
                <field name="line_ids" string="Articulo" filter_domain="[('line_ids.sku', 'ilike', self)]"/>
                <filter name="f_dev" string="Devoluciones" domain="[('tipo', '=', 'devolucion')]"/>
                <filter name="f_cor" string="Correcciones" domain="[('tipo', '=', 'correccion')]"/>
                <separator/>
                <filter name="f_error" string="Con error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="g_tienda" string="Tienda" context="{'group_by': 'tienda_id'}"/>
                    <filter name="g_estado" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_traspaso" model="ir.actions.act_window">
        <field name="name">Traspasos S4T</field>
        <field name="res_model">koroshi.s4t.traspaso</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_traspaso_search"/>
    </record>

    <menuitem id="menu_traspaso" name="Traspasos S4T (devoluciones y correcciones)"
              parent="stock.menu_stock_warehouse_mgmt" action="action_traspaso" sequence="91"/>
</odoo>
