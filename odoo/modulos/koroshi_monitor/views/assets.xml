<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" name="KOROSHI Monitor zonas assets" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <!-- Odoo 13 carga TouchSwipe de forma diferida en el Kanban movil. En algunas PDA el
                 renderer llega antes que el plugin e Inventario muestra "this.$el.swipe is not a function". -->
            <script type="text/javascript" src="/web/static/lib/jquery.touchSwipe/jquery.touchSwipe.js"/>
            <link rel="stylesheet" type="text/css" href="/koroshi_monitor/static/src/css/monitor.css"/>
            <link rel="stylesheet" type="text/css" href="/koroshi_monitor/static/src/css/envios.css"/>
            <script type="text/javascript" src="/koroshi_monitor/static/src/js/monitor.js"/>
            <script type="text/javascript" src="/koroshi_monitor/static/src/js/envios.js"/>
            <script type="text/javascript" src="/koroshi_monitor/static/src/js/mobile_swipe_guard.js"/>
        </xpath>
    </template>
</odoo>
