<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v3.34 (R7): segundos entre refrescos de la pantalla de preparar yendo solo y sin leer (ve lo que cambian
         Contenedores o Faltantes: otra ubicación). 0 = no refrescar (como antes). Mínimo 10.
         noupdate: lo que se cambie a mano no se pisa al actualizar (el registro se crea al actualizar si no existe). -->
    <data noupdate="1">
        <record id="param_refresco_solo" model="ir.config_parameter">
            <field name="key">koroshi_preparacion.refresco_solo_s</field>
            <field name="value">30</field>
        </record>
    </data>
</odoo>
