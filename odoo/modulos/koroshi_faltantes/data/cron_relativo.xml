<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.11.0 Cada hora: vuelve a calcular el % de faltante (koroshi.faltante.relativo). Solo escribe en su tabla. -->
    <record id="cron_koroshi_faltante_relativo" model="ir.cron">
        <field name="name">KOROSHI Faltantes: recalcular % de faltante</field>
        <field name="model_id" ref="model_koroshi_faltante_relativo"/>
        <field name="state">code</field>
        <field name="code">model.cron_recalcular()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <!-- v1.12.0 Cada 15 min: una vez al día, a partir de koroshi_faltantes.correo_hora (17:00, hora del almacén),
         recalcula y manda el correo del % de faltante a koroshi_faltantes.correo_destinatarios. -->
    <record id="cron_koroshi_faltante_relativo_correo" model="ir.cron">
        <field name="name">KOROSHI Faltantes: correo diario del % de faltante</field>
        <field name="model_id" ref="model_koroshi_faltante_relativo"/>
        <field name="state">code</field>
        <field name="code">model.cron_correo()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
