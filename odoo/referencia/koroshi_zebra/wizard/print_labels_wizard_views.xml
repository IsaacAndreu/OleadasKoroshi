<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zebra_label_print_wizard_form" model="ir.ui.view">
        <field name="name">zebra.label.print.wizard.form</field>
        <field name="model">zebra.label.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar e imprimir etiquetas">
                <group>
                    <field name="next_code_preview" readonly="1"/>
                    <field name="quantity"/>
                    <field name="note" placeholder="Ej: Lote 22/09/2026"/>
                </group>
                <footer>
                    <button name="action_generate_and_print" type="object"
                            string="Generar e Imprimir" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_zebra_label_print_wizard" model="ir.actions.act_window">
        <field name="name">Generar e Imprimir Etiquetas</field>
        <field name="res_model">zebra.label.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
