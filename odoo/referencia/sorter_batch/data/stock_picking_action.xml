<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="sorter_batch_create_files" model="ir.actions.server">
			<field name="name">Crear batches Sorter</field>
			<field name="type">ir.actions.server</field>
			<field name="model_id" ref="model_stock_picking"/>
			<field name="state">code</field>
			<field name="code">if records:model.create_batch_files(records)</field>
			<field name="groups_id" eval="[(4,ref('group_sorter_manager'))]"/>
		</record>

		<record id="sorter_batch_create_transfer" model="ir.actions.server">
			<field name="name">Crear transfer para oleada</field>
			<field name="type">ir.actions.server</field>
			<field name="model_id" ref="model_stock_picking"/>
			<field name="state">code</field>
			<field name="code">if records:model.create_transfer_for_batch(records)</field>
			<field name="groups_id" eval="[(4,ref('group_sorter_manager'))]"/>
		</record>
    </data>
</odoo>
